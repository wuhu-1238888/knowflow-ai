{
  "name": "knowflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "KnowFlow AI 企业 AI 知识助手(RAG 作品集项目,演示数据为虚构企业 NovaTech)",
  "scripts": {
    "dev": "concurrently -k -n web,rag -c blue,magenta \"next dev -p 3001\" \"python -m uvicorn rag_service.main:app --host 127.0.0.1 --port 8000\"",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
