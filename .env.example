# KnowFlow AI 环境配置(复制为 .env 使用;.env 不入库)
# LLM Provider:mock 为默认(零 Key 跑通全链路与评测);真实 provider 首选 deepseek,备选智谱
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
# 运行时数据目录(元数据库/LanceDB/本地模型统一放其下,不入库;模型体积数 GB)
KNOWFLOW_RUNTIME_DIR=runtime
# 网络受限时启用 HF 镜像(huggingface.co 直连失败时;HuggingFace 生态标准变量)
# HF_ENDPOINT=https://hf-mirror.com
